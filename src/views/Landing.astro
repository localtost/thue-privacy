---
// Landing, variant E «Кино» (approved 27.10.2026, docs/design/e.html): the App Store header clip (the rule + the island) fills
// the first screen under the name, the tagline and the badge; below — the mechanic as a looping diagram, six chapters, three
// difficulties and the badge once more. The clip has a pause button (WCAG 2.2.2); with Reduce Motion only the poster is shown.
import Base from '../layouts/Base.astro';
import { APP_STORE_URL, BADGE, ORIGIN, asset, t, url, type Key, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const description = t(lang, 'site.description');
const jsonld = {
  '@context': 'https://schema.org', '@type': ['VideoGame', 'MobileApplication'], name: 'Thue',
  operatingSystem: 'iOS', applicationCategory: 'GameApplication', gamePlatform: 'iPhone', url: ORIGIN + url(lang, 'home'),
  inLanguage: lang, description, image: ORIGIN + asset('og.v1.jpg'),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  ...(APP_STORE_URL ? { downloadUrl: APP_STORE_URL, installUrl: APP_STORE_URL } : {}),
};
const badge = asset(BADGE[lang]);
const k = (key: string) => t(lang, key as Key);
// chapter glyphs — the game's chapter marks (DESIGN_SYSTEM: A, B, A→A, ⊙⊡, AAA, A–D)
const CHAPTERS = ['A', 'B', 'A→A', '⊙⊡', 'AAA', 'A–D'].map((glyph, i) => ({ glyph, name: k(`chap.${i + 1}`), meta: k('chap.meta').replace('{n}', String(i + 1)) }));
const DIFFS = ['relaxed', 'normal', 'strict'].map((d) => [k(`diff.${d}`), k(`diff.${d}.text`)]);
const pause = `(function(){var v=document.getElementById('clip'),b=document.getElementById('clip-toggle');if(!v||!b)return;
var P=${JSON.stringify(t(lang, 'video.pause'))},R=${JSON.stringify(t(lang, 'video.play'))};
function sync(){var p=v.paused;b.setAttribute('aria-label',p?R:P);b.classList.toggle('paused',p)}
if(matchMedia('(prefers-reduced-motion: reduce)').matches){v.removeAttribute('autoplay');v.pause()}
b.addEventListener('click',function(){v.paused?v.play():v.pause()});v.addEventListener('play',sync);v.addEventListener('pause',sync);sync()})();`;
const right = '-.6,-.7 .75,0 -.6,.7';
const up = '-.7,.6 0,-.75 .7,.6';
---
<Base lang={lang} kind="home" title={t(lang, 'site.title')} description={description} theme="dusk" jsonld={jsonld}>
  <main id="main">
    <section class="hero" aria-labelledby="h1">
      <div class="media">
        <video id="clip" autoplay muted loop playsinline preload="metadata" poster={asset('media/kino-poster.v1.jpg')} width="1600" height="686" aria-label={t(lang, 'video.label')}>
          <source src={asset('media/kino.v1.webm')} type="video/webm">
          <source src={asset('media/kino.v1.mp4')} type="video/mp4">
        </video>
      </div>
      <div class="wrap copy">
        <div>
          <h1 id="h1">Thue</h1>
          <p class="tag">{t(lang, 'site.tagline')}</p>
          <div class="store">
            {APP_STORE_URL
              ? <a href={APP_STORE_URL}><img src={badge} alt={t(lang, 'store.alt')} width="156" height="52"></a>
              : <><img src={badge} alt={t(lang, 'store.alt')} width="156" height="52"><span class="soon">{t(lang, 'store.soon')}</span></>}
            <ul class="facts"><li>{t(lang, 'hero.genre')}</li><li>{t(lang, 'hero.platform')}</li><li>{t(lang, 'hero.free')}</li></ul>
          </div>
        </div>
        <button class="toggle" id="clip-toggle" type="button" aria-label={t(lang, 'video.pause')}>
          <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><rect x="3" y="2" width="3.5" height="12" rx="1"/><rect x="9.5" y="2" width="3.5" height="12" rx="1"/></svg>
          <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.2v11.6c0 .6.7 1 1.2.7l9-5.8a.8.8 0 0 0 0-1.4l-9-5.8C4.7 1.2 4 1.6 4 2.2z"/></svg>
        </button>
      </div>
    </section>

    <section class="mech" aria-labelledby="mech-h">
      <div class="wrap">
        <p class="kicker">{t(lang, 'mech.kicker')}</p>
        <h2 id="mech-h">{t(lang, 'mech.title')}</h2>
        <p class="intro">{t(lang, 'mech.text')}</p>
        <div class="demo slab">
          <div class="rules">
            <div><p class="lbl">{t(lang, 'demo.start')}</p><div class="rule"><span class="chip ref">A</span><span class="chip ref">A</span><span class="chip ref">A</span></div></div>
            <div><p class="lbl">{t(lang, 'demo.rule')}</p><div class="rule"><span class="chip head">A</span><span class="eq" aria-hidden="true">=</span>
              <span class="chip"><svg viewBox="-1 -1 2 2" aria-hidden="true"><polygon points={right}/></svg></span>
              <span class="swap"><span class="chip s1"><svg viewBox="-1 -1 2 2" aria-hidden="true"><polygon points={right}/></svg></span><span class="chip edit s2"><svg viewBox="-1 -1 2 2" aria-hidden="true"><polygon points={up}/></svg></span></span>
              <span class="chip"><svg viewBox="-1 -1 2 2" aria-hidden="true"><polygon points={up}/></svg></span></div></div>
            <p class="cap">{t(lang, 'demo.caption')}</p>
          </div>
          <svg class="map" viewBox="0 0 240 300" role="img" aria-label={t(lang, 'demo.map')}>
            <defs><pattern id="cell" width="30" height="30" patternUnits="userSpaceOnUse"><rect width="30" height="30" fill="#FFFBF6" stroke="#F0E2D3"/></pattern></defs>
            <rect width="240" height="300" rx="18" fill="url(#cell)"/>
            <rect x="91" y="91" width="28" height="28" rx="8" fill="#1F8F7E"/><rect x="98" y="98" width="14" height="21" rx="7" fill="#BDF2E1"/>
            <polyline class="s1 path" points="15,285 45,285 75,285 75,255 105,255 135,255 135,225 165,225 195,225 195,195" fill="none" stroke="#E8553D" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="2 12"/>
            <polyline class="s2 path" points="15,285 45,285 45,255 45,225 75,225 75,195 75,165 105,165 105,135 105,105" fill="none" stroke="#1F8F7E" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="15" cy="285" r="10" fill="#2C2A4A"/>
          </svg>
        </div>
      </div>
    </section>

    <section class="chap" aria-labelledby="chap-h">
      <div class="wrap">
        <p class="kicker">{t(lang, 'chap.kicker')}</p>
        <h2 id="chap-h">{t(lang, 'chap.title')}</h2>
        <ol>{CHAPTERS.map((c) => <li class="slab"><span class="chip head" aria-hidden="true">{c.glyph}</span><div><h3>{c.name}</h3><p>{c.meta}</p></div></li>)}</ol>
      </div>
    </section>

    <section class="diff" aria-labelledby="diff-h">
      <div class="wrap">
        <p class="kicker">{t(lang, 'diff.kicker')}</p>
        <h2 id="diff-h">{t(lang, 'diff.title')}</h2>
        <ul>{DIFFS.map(([h, p]) => <li><h3>{h}</h3><p>{p}</p></li>)}</ul>
      </div>
    </section>

    <section class="end" aria-labelledby="end-h">
      <div class="wrap">
        <h2 id="end-h">{t(lang, 'end.title')}</h2>
        <p>{t(lang, 'end.text')}</p>
        <div class="store">
          {APP_STORE_URL
            ? <a href={APP_STORE_URL}><img src={badge} alt={t(lang, 'store.alt')} width="156" height="52" loading="lazy"></a>
            : <><img src={badge} alt={t(lang, 'store.alt')} width="156" height="52" loading="lazy"><span class="soon">{t(lang, 'store.soon')}</span></>}
        </div>
      </div>
    </section>
  </main>
  <script is:inline set:html={pause} />
</Base>

<style is:global>
body.dusk { background: #2C2A4A; color: var(--cream); }
.dusk .shell { position: absolute; left: 0; right: 0; top: 0; z-index: 3; }
.dusk .brand { color: var(--cream); }
.dusk .langs { background: rgba(255, 255, 255, .12); border-color: rgba(255, 255, 255, .25); }
.dusk .langs a { color: var(--cream-soft); }
.dusk .langs a:hover { color: var(--cream); }
.dusk .langs a[aria-current] { background: var(--cream); color: var(--night); box-shadow: 0 3px 0 var(--chip-lip); }
.dusk .foot { color: var(--cream-soft); border-top: 1px solid rgba(255, 245, 233, .12); }
.dusk .foot nav a { color: var(--cream); }
.dusk .foot nav a:hover { background: rgba(255, 255, 255, .1); }
.dusk :focus-visible { outline-color: var(--cream); }
</style>
<style>
/* hero: the clip under the copy */
.hero { position: relative; min-height: min(820px, 100vh); min-height: min(820px, 100svh); display: flex; flex-direction: column; background: #36306A; overflow: hidden; }
.media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 30% 50%; }
.hero::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, rgba(54, 48, 106, .55) 0%, rgba(54, 48, 106, 0) 28%, rgba(44, 42, 74, 0) 52%, rgba(44, 42, 74, .88) 100%); }
.copy { position: relative; z-index: 1; width: 100%; margin-top: auto; padding-bottom: 48px; display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 24px; }
h1 { font-weight: 900; font-size: clamp(64px, 10vw, 128px); letter-spacing: -.02em; line-height: .9; margin: 0; color: var(--cream); text-shadow: 0 6px 30px rgba(24, 23, 46, .4); }
.tag { font-size: clamp(22px, 2.8vw, 32px); font-weight: 900; margin: 10px 0 22px; color: #FFE4CE; }
.store img { height: 52px; }
.facts { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
.facts li, .soon { display: inline-flex; align-items: center; min-height: 30px; padding: 0 12px; border-radius: 999px; font-weight: 900; font-size: 13px; background: rgba(255, 255, 255, .14); border: 1px solid rgba(255, 255, 255, .3); color: var(--cream); }
.toggle { position: relative; z-index: 2; width: 48px; height: 48px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, .4); background: rgba(24, 23, 46, .45); color: var(--cream); display: grid; place-items: center; cursor: pointer; padding: 0; }
.toggle svg { width: 16px; height: 16px; fill: currentColor; grid-area: 1 / 1; }
.toggle .i-play, .toggle.paused .i-pause { display: none; }
.toggle.paused .i-play { display: block; }

/* sections */
.mech { padding: 90px 0 70px; }
.kicker { color: #F8C2B3; }
h2 { font-weight: 900; font-size: clamp(28px, 3.6vw, 42px); letter-spacing: -.01em; margin: 6px 0 14px; color: var(--cream); }
.intro { max-width: 36em; font-weight: 700; font-size: 18px; line-height: 1.55; color: var(--cream-soft); margin: 0 0 36px; }

/* rule chips — the game's RuleChip in HTML/SVG (arrows are drawn, never emoji glyphs) */
.rule { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.chip { --s: 52px; width: var(--s); height: var(--s); border-radius: calc(var(--s) * .26); display: grid; place-items: center; background: var(--chip-face); border: 1px solid var(--chip-edge); box-shadow: 0 calc(var(--s) * .08) 0 var(--chip-lip), var(--shadow); font-weight: 900; font-size: calc(var(--s) * .44); color: var(--night); }
.chip svg { width: 46%; height: 46%; fill: var(--night); }
.chip.head { background: var(--night-face); border-color: #46427A; box-shadow: 0 calc(var(--s) * .08) 0 var(--night-deep), var(--shadow); color: var(--cream); }
.chip.ref { background: linear-gradient(180deg, #FFFFFF, #EFF8F1); border-color: #CFE6D8; box-shadow: 0 calc(var(--s) * .08) 0 #A9CDB8, var(--shadow); color: #1F4E45; }
.chip.edit { background: linear-gradient(180deg, #FFF7F3, #FFE6DC); border-color: #F3C3B3; box-shadow: 0 calc(var(--s) * .08) 0 #E8553D, var(--shadow); }
.chip.edit svg { fill: #E8553D; }
.eq { font-weight: 900; font-size: 30px; color: var(--night); opacity: .8; }

.demo { display: grid; grid-template-columns: 1fr 1.2fr; gap: 36px; align-items: center; padding: 34px; }
.rules { display: grid; gap: 18px; justify-items: start; }
.lbl { font-weight: 900; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--night-soft); margin: 0 0 6px; }
.swap { position: relative; }
.swap .s2 { position: absolute; inset: 0; }
.map { width: 100%; max-width: 300px; height: auto; justify-self: center; }
.cap { margin: 0; font-weight: 700; font-size: 15px; line-height: 1.5; color: var(--night-body); }
/* before → after: A = ▶ ▶ ▲ becomes A = ▶ ▲ ▲, the path changes in all three places at once */
.s2 { opacity: 0; }
@media (prefers-reduced-motion: no-preference) {
  .s1 { animation: before 6s infinite; }
  .s2 { animation: after 6s infinite; }
}
@keyframes before { 0%, 42% { opacity: 1; } 50%, 92% { opacity: 0; } 100% { opacity: 1; } }
@keyframes after { 0%, 42% { opacity: 0; } 50%, 92% { opacity: 1; } 100% { opacity: 0; } }
@media (prefers-reduced-motion: reduce) { .s2 { opacity: 1; } .path.s1 { opacity: .35; } .swap .s1 { visibility: hidden; } }

.chap { padding: 30px 0 70px; }
.chap ol { list-style: none; padding: 0; margin: 26px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.chap li { padding: 22px; display: flex; gap: 16px; align-items: center; border-radius: 24px; }
.chap .chip { --s: 56px; font-size: 18px; flex: none; }
.chap h3 { margin: 0; font-weight: 900; font-size: 19px; color: var(--night); }
.chap li p { margin: 2px 0 0; font-weight: 700; font-size: 14px; color: var(--night-soft); }

.diff { background: linear-gradient(180deg, #2C2A4A, #36306A); padding: 30px 0 80px; }
.diff ul { list-style: none; padding: 0; margin: 26px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.diff li { padding: 22px 24px; border-radius: 24px; border: 1px solid rgba(255, 255, 255, .16); background: rgba(255, 255, 255, .06); }
.diff h3 { margin: 0 0 8px; font-weight: 900; font-size: 22px; color: #FFE4CE; }
.diff li p { margin: 0; font-weight: 700; color: var(--cream-soft); line-height: 1.5; }

.end { background: var(--sky-dusk); text-align: center; padding: 80px 0 90px; }
.end h2 { margin-bottom: 8px; text-shadow: 0 4px 20px rgba(54, 48, 106, .35); }
.end p { font-weight: 800; margin: 0 0 24px; font-size: 18px; color: var(--cream); text-shadow: 0 2px 12px rgba(54, 48, 106, .45); }
.end .store { justify-content: center; }

@media (max-width: 860px) {
  .hero { min-height: 0; }
  .media { position: relative; }
  .media video { position: relative; height: auto; aspect-ratio: 2 / 1; object-position: 35% 50%; }
  .hero::after { bottom: auto; height: calc(100vw * .5); background: linear-gradient(180deg, rgba(54, 48, 106, .6) 0%, rgba(54, 48, 106, 0) 30%); }
  .copy { position: static; grid-template-columns: 1fr; margin-top: 0; padding: 24px max(20px, env(safe-area-inset-left)) 40px; text-align: center; background: #2C2A4A; }
  .copy .store { justify-content: center; }
  .facts { justify-content: center; }
  .toggle { position: absolute; right: 14px; top: calc(100vw * .5 - 62px); }
  .demo { grid-template-columns: 1fr; padding: 22px; }
  .chap ol, .diff ul { grid-template-columns: 1fr; }
}
</style>
